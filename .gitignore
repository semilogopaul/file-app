# Environment files - each app documents its required vars in .env.example
.env
.env.*
!.env.example
!**/.env.example

# TLS material - generated locally or mounted from a secrets manager, never committed
nginx/certs/*.pem
nginx/certs/*.key
nginx/certs/*.crt

# OS/editor cruft
.DS_Store
.vscode/
.idea/

# Agent instruction files - local working notes, not part of the deliverable.
# AGENTS.md is regenerated by `next dev`, so it is ignored rather than deleted.
CLAUDE.md
**/CLAUDE.md
AGENTS.md
**/AGENTS.md
