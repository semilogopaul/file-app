# Copy this file to .env for local development, or .env.production for the
# Docker Compose stack (see docker-compose.yml `env_file`). Validated at
# startup by src/config/validation.schema.ts - the process refuses to boot
# if a required value is missing or malformed.

NODE_ENV=production
PORT=4000

# --- Database ---------------------------------------------------------------
# Local development (Postgres published on the host by docker-compose.dev.yml,
# on 5434 by default to avoid colliding with an existing local Postgres):
#   postgresql://fileapp:fileapp@localhost:5434/fileapp?schema=public
# Inside the Docker network, docker-compose.yml supplies this automatically
# using the `postgres` service name.
DATABASE_URL=postgresql://fileapp:fileapp@postgres:5432/fileapp?schema=public

# --- Auth -------------------------------------------------------------------
# Must be at least 32 characters; startup validation rejects anything shorter
# because a short secret makes HS256 tokens brute-forceable offline.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters

# Token lifetime, as <number><unit> where unit is one of s/m/h/d/w/y.
JWT_EXPIRES_IN=7d

# --- Object storage (MinIO locally, any S3-compatible service in prod) ------
# Address the API uses for its own calls. Inside Docker this is the service
# name; running the API on the host it is http://localhost:9000.
STORAGE_ENDPOINT=http://minio:9000

# Address baked into presigned URLs. Must be reachable BY THE BROWSER.
#
# In the Docker stack this points at nginx, NOT at MinIO directly, and nginx
# proxies the bucket path straight through. Two things force that: the app is
# served over HTTPS, so an http:// storage URL is blocked as mixed content;
# and our CSP sets `connect-src 'self'`, which blocks a cross-origin upload
# XHR outright. Same-origin storage satisfies both without loosening the CSP.
#
# SigV4 signs the host and path, so nginx must forward both unchanged - see
# the /file-app/ location in nginx/conf.d/default.conf.
#
# Running the API on the host without nginx, use http://localhost:9000.
STORAGE_PUBLIC_ENDPOINT=https://localhost

STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=fileapp-access-key
STORAGE_SECRET_KEY=fileapp-secret-key
STORAGE_BUCKET=file-app
# MinIO addresses buckets by path; real S3 uses virtual-hosted style.
STORAGE_FORCE_PATH_STYLE=true
# How long an upload URL stays valid (seconds).
STORAGE_UPLOAD_URL_TTL_SECONDS=900
# Download URLs are shorter-lived; they are handed out far more often.
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300

# --- Uploads ----------------------------------------------------------------
# 10MB, per the brief. Enforced at /uploads/init against the declared size
# and re-checked against the object's real size at /uploads/:id/complete.
UPLOAD_MAX_BYTES=10485760

# --- Sharing -----------------------------------------------------------------
# How long a share link stays valid, in seconds. Configurable per the brief;
# capped at 30 days by startup validation because a share link is an
# unauthenticated bearer credential - an unbounded lifetime would mean a
# leaked URL grants access forever.
SHARE_TOKEN_TTL_SECONDS=86400

# Public origin used to build the shareable URLs handed to users. Must match
# how the app is actually reached, or copied links will point nowhere.
APP_PUBLIC_URL=https://localhost

# --- CORS -------------------------------------------------------------------
# Comma-separated list of exact origins allowed to call this API directly
# (browser -> API, bypassing the nginx same-origin proxy - e.g. a mobile
# app or a separate marketing site). Leave empty to disable CORS entirely,
# which is the norm here since nginx proxies the frontend and API under one
# origin in production. Never use "*" in production.
CORS_ORIGINS=
