{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    // Prisma CLI config - used by `prisma migrate`/`generate`, never by the
    // running app. Excluding it keeps the compiled output rooted at src/,
    // so the entrypoint stays dist/main.js.
    "prisma.config.ts"
  ]
}
