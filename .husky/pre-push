# Slower, higher-confidence gate before code leaves the machine.
#
#   test  - backend Jest unit tests + frontend Vitest suite
#   build - `nest build` and `next build`. A production build catches things
#           `tsc --noEmit` does not: bad imports, server/client boundary
#           violations in the App Router, and Next's own build-time checks.
#
# Deliberately NOT here: the backend e2e suite (`npm run test:e2e`). Once it
# needs a live Postgres/MinIO it would make pushing depend on infra being up
# and break offline work. That belongs in CI, where the services can be
# provisioned as containers.
#
# Bypass with `git push --no-verify`.
echo "→ pre-push: test"
npm run test

echo "→ pre-push: build"
npm run build
