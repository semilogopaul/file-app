# Copy this file to .env.local for local development, or .env.production
# for the Docker Compose stack (see docker-compose.yml `env_file`).

NODE_ENV=production
PORT=3000

# Browser-facing API base URL.
#   - Behind the production nginx proxy (default): keep this relative so
#     requests are same-origin and CORS never applies.
#   - Local dev without nginx (`npm run dev` + backend on :4000 directly):
#     set to http://localhost:4000 instead.
NEXT_PUBLIC_API_URL=/api

# Server-only API base URL, used by Server Components/Route Handlers running
# inside the Docker network. Never exposed to the browser.
API_INTERNAL_URL=http://backend:4000
